<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/notFound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/spacing_lg"
            android:text="@string/transaction_not_found"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/heroAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="@dimen/spacing_md"
                android:textAppearance="?attr/textAppearanceHeadlineLarge"
                android:textStyle="bold"
                tools:text="−₦25,000.00" />

            <TextView
                android:id="@+id/heroStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/spacing_sm"
                android:background="@drawable/bg_badge"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:textAppearance="?attr/textAppearanceLabelLarge"
                tools:text="Successful" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Material3.CardView.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <com.akeem.mobilebanking.ui.common.DetailRowView
                        android:id="@+id/rowReference"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:rowLabel="@string/row_reference" />

                    <com.akeem.mobilebanking.ui.common.DetailRowView
                        android:id="@+id/rowDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        app:rowLabel="@string/row_description" />

                    <com.akeem.mobilebanking.ui.common.DetailRowView
                        android:id="@+id/rowAmount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        app:rowLabel="@string/row_amount" />

                    <com.akeem.mobilebanking.ui.common.DetailRowView
                        android:id="@+id/rowDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        app:rowLabel="@string/row_date" />

                    <com.akeem.mobilebanking.ui.common.DetailRowView
                        android:id="@+id/rowType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        app:rowLabel="@string/row_type" />

                    <com.akeem.mobilebanking.ui.common.DetailRowView
                        android:id="@+id/rowStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_md"
                        app:rowLabel="@string/row_status" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
